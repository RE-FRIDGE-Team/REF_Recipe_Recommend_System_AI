# .env.example — 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채울 것 (.env 는 git 제외됨)
#   cp .env.example .env

# ── recipe_crawler_model (필수) ─────────────────
# YouTube Data API v3 키
# 발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → API 키
#       (YouTube Data API v3 를 활성화해야 함)
YOUTUBE_API_KEY=

# ── LLM 정제 (선택) ─────────────────────────────
# --processor llm 옵션을 쓸 때만 필요. 없으면 규칙 기반으로 동작함.
ANTHROPIC_API_KEY=
